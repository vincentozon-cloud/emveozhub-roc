// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The url and directUrl are now handled by prisma.config.ts
}

model Telemetry {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  category    String
  severity    Float
  impact      Float
  origin      String
  status      String   @default("UNRESOLVED")
  analystNote String?
}